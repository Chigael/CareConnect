# Supabase Public Credentials (Safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret Admin Key (NEVER use NEXT_PUBLIC_ prefix! Keep secret on server & Vercel)
# Used for secure server-side account deletion via auth.admin.deleteUser()
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

